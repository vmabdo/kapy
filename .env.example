# ============================================================
# Kapy Pharma — Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file with real secrets to git.
# ============================================================

# ============================================================
# DATABASE (PostgreSQL)
# ============================================================
# Recommended: Neon (neon.tech) — free serverless PostgreSQL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/kapy_pharma?sslmode=require"

# ============================================================
# AUTH.JS v5 (NextAuth)
# ============================================================
# Generate a strong secret with: openssl rand -base64 32
# Or use: https://generate-secret.vercel.app/32
AUTH_SECRET="REPLACE_WITH_A_STRONG_RANDOM_SECRET_32_CHARS"

# The canonical URL of your app (no trailing slash)
NEXTAUTH_URL="http://localhost:3000"

# ============================================================
# APP CONFIGURATION (Optional)
# ============================================================
NEXT_PUBLIC_APP_NAME="Kapy Pharma"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
