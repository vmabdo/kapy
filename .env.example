# ============================================================
# Kapy Pharma — Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file with real secrets to git.
# ============================================================

# ============================================================
# DATABASE (PostgreSQL)
# ============================================================
# Recommended: Neon (neon.tech) — free serverless PostgreSQL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/kapy_pharma?sslmode=require"
# Direct connection used by Prisma Migrate/introspection.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/kapy_pharma?sslmode=require"

# Supabase (Session Pooler): keep the Prisma pool small so bursts of
# Promise.all queries queue instead of opening 10+ sockets at once.
# Keep DIRECT_URL on port 5432 for migrations; percent-encode special
# characters in the password (for example @ -> %40).
# DATABASE_URL="postgresql://USER:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?pgbouncer=true&connection_limit=3&pool_timeout=20&connect_timeout=15"
# DIRECT_URL="postgresql://USER:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ============================================================
# AUTH.JS v5 (NextAuth)
# ============================================================
# Generate a strong secret with: openssl rand -base64 32
# Or use: https://generate-secret.vercel.app/32
AUTH_SECRET="REPLACE_WITH_A_STRONG_RANDOM_SECRET_32_CHARS"

# The canonical URL of your app (no trailing slash)
NEXTAUTH_URL="http://localhost:3000"

# ============================================================
# APP CONFIGURATION (Optional)
# ============================================================
NEXT_PUBLIC_APP_NAME="Kapy Pharma"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
